{
  "name": "dsh-mm-models",
  "version": "0.1.1",
  "description": "DeepSeek 主脑 + GLM/Qwen 读图 / Qwen 制图 / Seedance·可灵·万相 出片：把外部多模态能力做成与 bash 同级的顶级工具，共用异步任务层、多 key 管理与成本闸门。",
  "type": "module",
  "license": "MIT",
  "author": "dsh-mm-models contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanfangtown/CN-gpt.git"
  },
  "homepage": "https://github.com/nanfangtown/CN-gpt#readme",
  "bugs": {
    "url": "https://github.com/nanfangtown/CN-gpt/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multimodal",
    "vision",
    "qwen-vl",
    "image-generation",
    "video-generation",
    "dashscope",
    "bailian",
    "zhipu",
    "volcengine-ark"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "core",
    "tasks",
    "tools",
    "locale",
    "icon.svg",
    "README.md",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20.6.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "scripts": {
    "test": "node --import ./tests/register.mjs ./tests/run.mjs && node --import ./tests/register.mjs ./tests/safety-invariants.test.mjs && node tests/client-card.test.mjs && node tests/_card-mutex.test.mjs && node --import ./tests/register.mjs ./tests/verify-functionality.mjs && node --import ./tests/register.mjs ./tests/video-gen.test.mjs",
    "test:video": "node --import ./tests/register.mjs ./tests/video-gen.test.mjs",
    "test:safety": "node --import ./tests/register.mjs ./tests/safety-invariants.test.mjs",
    "test:verify": "node --import ./tests/register.mjs ./tests/verify-functionality.mjs",
    "test:mutation": "node tests/_mutation-check.mjs",
    "test:perf": "node --import ./tests/register.mjs ./tests/_perf-bench.mjs",
    "test:sizes": "node --import ./tests/register.mjs ./tests/size-report.mjs",
    "test:docs": "node tests/check-doc-links.mjs",
    "probe:video": "node tests/probe-dashscope-video.mjs"
  },
  "meta": {
    "title": "CN-gpt（读图 / 制图 / 出片）",
    "description": "一个插件，做成中国的GPT"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
