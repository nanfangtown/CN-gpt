# dsh-mm-models 需要的环境变量
#
# 用法：复制成 `~/.dsh/.env`（或设置成系统环境变量）。
# ⚠ 这个文件里只有**密钥**；模型 id / 端点 / 业务空间等配置属于 profile 配置，
#   不放在这里（见 README 的「配置」一节）。
# ⚠ 永远不要把填好的 .env 提交到仓库。

# 百炼 DashScope：qwen_draw 制图 + ask_qwen 读图 + video_gen 出片（三家共用这一把）
DASHSCOPE_API_KEY=

# 智谱：ask_glm 读图（与 DASHSCOPE 那条二选一；也可以走 设置 → 模型 → GLM 行）
ZHIPU_API_KEY=

# 火山方舟：仅 seedance_video 出片使用（不打算用可空着）
ARK_API_KEY=
